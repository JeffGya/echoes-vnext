diff --git a/core/PerfProbe.gd b/core/PerfProbe.gd
new file mode 100644
index 0000000..88953c3
--- /dev/null
+++ b/core/PerfProbe.gd
@@ -0,0 +1,70 @@
+# TEMP-PROBE: stutter investigation. Delete this file and every "TEMP-PROBE" line before any commit.
+# Prints one line when a measured span is slower than THRESHOLD_MS.
+class_name PerfProbe
+
+const THRESHOLD_MS := 8.0
+const FRAME_SPIKE_MS := 28.0
+
+static var last_action: String = ""
+static var last_action_msec: int = 0
+
+# Lap timer: begin() ... lap(name) ... end() prints one line with every phase.
+static var _group: String = ""
+static var _start: int = 0
+static var _last: int = 0
+static var _laps: PackedStringArray = PackedStringArray()
+
+# Accumulators: acc_add(name, start_usec) sums time and call count per name until acc_reset().
+static var _acc_us: Dictionary = {}
+static var _acc_n: Dictionary = {}
+
+
+static func now() -> int:
+	return Time.get_ticks_usec()
+
+
+## Returns the span in milliseconds. Prints when the span is at or above the threshold.
+static func report(label: String, start_usec: int, extra: String = "") -> float:
+	var ms: float = float(Time.get_ticks_usec() - start_usec) / 1000.0
+	if ms >= THRESHOLD_MS:
+		print("[PROBE] %-22s %6.1f ms %s" % [label, ms, extra])
+	return ms
+
+
+static func begin(group: String) -> void:
+	_group = group
+	_start = Time.get_ticks_usec()
+	_last = _start
+	_laps = PackedStringArray()
+	acc_reset()
+
+
+## Records the time since the previous lap (or begin) under `phase`.
+static func lap(phase: String) -> void:
+	var t: int = Time.get_ticks_usec()
+	_laps.append("%s=%.1f" % [phase, float(t - _last) / 1000.0])
+	_last = t
+
+
+## Prints the group line when the whole group is at or above the threshold.
+static func end(extra: String = "") -> void:
+	var total_ms: float = float(Time.get_ticks_usec() - _start) / 1000.0
+	if total_ms >= THRESHOLD_MS:
+		print("[PROBE] %s %.1f ms | %s | %s %s" % [_group, total_ms, " ".join(_laps), acc_text(), extra])
+
+
+static func acc_reset() -> void:
+	_acc_us.clear()
+	_acc_n.clear()
+
+
+static func acc_add(name: String, start_usec: int) -> void:
+	_acc_us[name] = int(_acc_us.get(name, 0)) + (Time.get_ticks_usec() - start_usec)
+	_acc_n[name] = int(_acc_n.get(name, 0)) + 1
+
+
+static func acc_text() -> String:
+	var parts := PackedStringArray()
+	for name in _acc_us:
+		parts.append("%s x%d=%.1f" % [name, int(_acc_n[name]), float(_acc_us[name]) / 1000.0])
+	return " ".join(parts)
